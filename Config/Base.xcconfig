// Shared build settings. Signing defaults to ad-hoc ("Sign to Run Locally"),
// which needs no Apple account. To sign with your Apple Developer team, copy
// Signing.xcconfig.example to Signing.xcconfig (gitignored) and fill it in.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
OTHER_CODE_SIGN_FLAGS = --timestamp=none

#include? "Signing.xcconfig"
