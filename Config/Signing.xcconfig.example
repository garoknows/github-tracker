// Copy to Config/Signing.xcconfig (gitignored) to build with your Apple Developer team.
// Nothing in the code needs to change. Never commit the real file.

CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = Developer ID Application
DEVELOPMENT_TEAM = YOURTEAMID
OTHER_CODE_SIGN_FLAGS = --timestamp

// App Group shared by the app and the widget, so widgets can use the app's favorites.
TRACKER_APP_GROUP = $(DEVELOPMENT_TEAM).io.github.garoknows.tracker
TRACKER_APP_ENTITLEMENTS = App/TrackerForGitHub-Signed.entitlements
TRACKER_WIDGET_ENTITLEMENTS = Widgets/TrackerWidgets-Signed.entitlements
